{
  "name": "smart-wallet-hostinger",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/prepare-database.mjs && next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "design:preview": "vite --config design/preview/vite.config.mjs",
    "design:check": "node scripts/check-design.mjs",
    "brand:generate": "node scripts/generate-brand.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.49.0",
    "next": "^15.3.1",
    "next-auth": "^5.0.0-beta.28",
    "next-themes": "^0.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "yauzl": "^3.4.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/yauzl": "^3.4.0",
    "@vitest/mocker": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "deepmerge-ts": "^8.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "postcss-selector-parser": "^7.1.6",
    "prisma": "^6.7.0",
    "source-map-js": "^1.2.2",
    "tailwindcss": "^3.4.17",
    "tinypool": "^2.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
